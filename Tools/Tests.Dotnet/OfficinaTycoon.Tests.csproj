<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the SAME sources Unity compiles (Assets/Scripts/Core) and the SAME NUnit tests
    (Assets/Tests/EditMode) outside the Unity Editor: `dotnet test Tools/Tests.Dotnet`.
    LangVersion 9 matches Unity 6 (C# 9) so the build catches syntax Unity would reject.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>OfficinaTycoon.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Unity/Loc.cs" />
    <Compile Include="../../Assets/Scripts/Unity/Fmt.cs" />
    <Compile Include="../../Tools/SharedTextTests/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
