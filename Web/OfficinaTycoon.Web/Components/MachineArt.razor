@* 2D illustration of each machine. Animated parts carry a-* classes (see app.css); speed comes from --d on the parent.
   Pure SVG drawn in code: no external images, nothing fetched. *@
<svg viewBox="0 0 100 100" class="art art-@Id" aria-hidden="true" focusable="false">
    <ellipse cx="50" cy="92" rx="42" ry="5" class="shadow" />
    @switch (Id)
    {
        case "drill":
            <rect x="22" y="80" width="56" height="10" rx="2" fill="#2b333f" />
            <rect x="30" y="16" width="9" height="66" fill="#8fa3b8" />
            <rect x="34" y="62" width="44" height="5" rx="1" fill="#5d6b7a" />
            <rect x="44" y="56" width="22" height="6" rx="1" fill="#c9a26b" />
            <g class="a-drill">
                <rect x="47" y="30" width="8" height="12" fill="#5d6b7a" />
                <polygon points="48,42 54,42 51,55" fill="#e6edf3" />
            </g>
            <rect x="24" y="10" width="46" height="22" rx="4" fill="@Color" />
            <circle cx="33" cy="21" r="4.5" fill="#1c2129" />
            <rect x="60" y="18" width="16" height="3" rx="1.5" fill="#8fa3b8" />
            <g class="a-sparks">
                <circle cx="48" cy="55" r="1.4" fill="#ffd27a" /><circle cx="55" cy="54" r="1.1" fill="#ffb347" /><circle cx="51" cy="52.5" r="0.9" fill="#fff" />
            </g>
            break;
        case "lathe":
            <rect x="6" y="72" width="88" height="10" rx="2" fill="#2b333f" />
            <rect x="9" y="82" width="9" height="8" fill="#2b333f" /><rect x="82" y="82" width="9" height="8" fill="#2b333f" />
            <rect x="8" y="36" width="24" height="36" rx="3" fill="@Color" />
            <circle cx="16" cy="44" r="2" fill="#e6edf3" />
            <rect x="74" y="48" width="16" height="24" rx="2" fill="#5d6b7a" />
            <rect x="46" y="52" width="30" height="8" fill="#e6edf3" />
            <g class="a-spin">
                <circle cx="38" cy="56" r="10" fill="#8fa3b8" />
                <rect x="36.5" y="46" width="3" height="20" fill="#2b333f" />
                <rect x="28" y="54.5" width="20" height="3" fill="#2b333f" />
            </g>
            <g class="a-slide-x">
                <polygon points="55,63 63,63 59,59" fill="#ffd27a" />
                <rect x="53" y="63" width="12" height="6" fill="#5d6b7a" />
            </g>
            <g class="a-sparks"><circle cx="59" cy="59" r="1.2" fill="#ffd27a" /><circle cx="62" cy="57" r="0.9" fill="#fff" /></g>
            break;
        case "mill":
            <rect x="12" y="84" width="76" height="6" fill="#2b333f" />
            <rect x="14" y="20" width="18" height="64" fill="@Color" />
            <rect x="14" y="12" width="64" height="12" rx="2" fill="@Color" />
            <rect x="56" y="24" width="16" height="14" fill="#5d6b7a" />
            <rect x="40" y="66" width="38" height="18" fill="#3a4554" />
            <g class="a-slide-x">
                <rect x="34" y="58" width="50" height="8" fill="#8fa3b8" />
                <rect x="52" y="51" width="20" height="7" fill="#c9a26b" />
            </g>
            <g class="a-spin">
                <circle cx="64" cy="45" r="6.5" fill="#e6edf3" />
                <rect x="63" y="38" width="2" height="14" fill="#5d6b7a" />
                <rect x="57" y="44" width="14" height="2" fill="#5d6b7a" />
            </g>
            <g class="a-sparks"><circle cx="60" cy="51" r="1.2" fill="#ffd27a" /><circle cx="68" cy="51" r="1" fill="#fff" /></g>
            break;
        case "cnc":
            <rect x="10" y="14" width="80" height="74" rx="6" fill="@Color" />
            <rect x="16" y="22" width="48" height="42" rx="3" fill="#0f1720" />
            <rect x="22" y="56" width="36" height="5" fill="#5d6b7a" />
            <rect x="30" y="51" width="18" height="5" fill="#c9a26b" />
            <g class="a-slide-x">
                <rect x="35" y="24" width="8" height="18" fill="#8fa3b8" />
                <g class="a-spin"><circle cx="39" cy="46" r="4" fill="#e6edf3" /><rect x="38.4" y="42" width="1.2" height="8" fill="#5d6b7a" /></g>
                <g class="a-sparks"><circle cx="37" cy="51" r="1.1" fill="#7fe3ff" /><circle cx="42" cy="51" r="0.9" fill="#fff" /></g>
            </g>
            <rect x="68" y="22" width="16" height="32" rx="2" fill="#1c2129" />
            <rect x="70" y="25" width="12" height="9" rx="1" fill="#3fd0ff" class="a-blink" />
            <circle cx="73" cy="41" r="1.8" fill="#6ec878" /><circle cx="79" cy="41" r="1.8" fill="#e65a50" />
            <rect x="70" y="46" width="12" height="3" rx="1" fill="#5d6b7a" />
            <rect x="14" y="70" width="72" height="12" rx="2" fill="#1c2129" />
            <rect x="83" y="2" width="3" height="12" fill="#5d6b7a" />
            <circle cx="84.5" cy="4" r="3" class="a-beacon" />
            break;
        case "press":
            <rect x="10" y="86" width="80" height="4" fill="#2b333f" />
            <rect x="16" y="12" width="10" height="76" fill="@Color" />
            <rect x="74" y="12" width="10" height="76" fill="@Color" />
            <rect x="12" y="6" width="76" height="16" rx="2" fill="@Color" />
            <rect x="44" y="20" width="12" height="8" fill="#5d6b7a" />
            <rect x="26" y="74" width="48" height="12" fill="#3a4554" />
            <rect x="34" y="68" width="32" height="6" rx="1" fill="#e6edf3" class="a-part" />
            <g class="a-stamp">
                <rect x="45" y="26" width="10" height="10" fill="#8fa3b8" />
                <rect x="30" y="34" width="40" height="12" rx="1" fill="#5d6b7a" />
                <rect x="30" y="44" width="40" height="2" fill="#2b333f" />
            </g>
            <g class="a-sparks"><circle cx="32" cy="67" r="1.2" fill="#ffd27a" /><circle cx="68" cy="67" r="1.2" fill="#ffd27a" /></g>
            break;
        case "robot":
            <rect x="28" y="84" width="44" height="6" rx="1" fill="#2b333f" />
            <rect x="38" y="72" width="24" height="12" rx="3" fill="@Color" />
            <rect x="70" y="70" width="20" height="14" rx="1" fill="#c9a26b" />
            <g class="a-swing" style="transform-origin:50px 72px">
                <rect x="46" y="38" width="8" height="36" rx="3" fill="@Color" />
                <circle cx="50" cy="72" r="5" fill="#1c2129" />
                <g class="a-swing2" style="transform-origin:50px 40px">
                    <rect x="48" y="36" width="32" height="8" rx="3" fill="#8fa3b8" />
                    <circle cx="50" cy="40" r="4" fill="#1c2129" />
                    <rect x="79" y="33" width="4" height="14" rx="1" fill="#5d6b7a" />
                    <circle cx="86" cy="40" r="2.6" fill="#7fe3ff" class="a-blink" />
                </g>
            </g>
            break;
        case "line":
            <defs><clipPath id="beltclip"><rect x="4" y="60" width="92" height="14" rx="7" /></clipPath></defs>
            <rect x="4" y="74" width="5" height="14" fill="#2b333f" /><rect x="91" y="74" width="5" height="14" fill="#2b333f" />
            <rect x="4" y="60" width="92" height="14" rx="7" fill="#1c2129" />
            <g clip-path="url(#beltclip)">
                <g class="a-belt">
                    @for (int i = 0; i < 12; i++)
                    {
                        <rect x="@(i * 10)" y="62" width="4" height="10" fill="#3a4554" />
                    }
                </g>
            </g>
            <g class="a-carry">
                <rect x="8" y="49" width="12" height="11" rx="1" fill="@Color" />
                <rect x="40" y="49" width="12" height="11" rx="1" fill="@Color" />
                <rect x="72" y="49" width="12" height="11" rx="1" fill="@Color" />
            </g>
            <rect x="8" y="14" width="84" height="6" fill="#ebd250" />
            <rect x="10" y="20" width="4" height="40" fill="#5d6b7a" /><rect x="86" y="20" width="4" height="40" fill="#5d6b7a" />
            <g class="a-bob">
                <rect x="49" y="20" width="2" height="14" fill="#8fa3b8" />
                <rect x="43" y="34" width="14" height="7" rx="1" fill="#8fa3b8" />
            </g>
            break;
        default: // smart factory
            <rect x="12" y="34" width="76" height="54" fill="#22303d" />
            <polygon points="12,34 12,28 25,16 25,28 38,16 38,28 51,16 51,28 64,16 64,28 88,28 88,34" fill="@Color" />
            @for (int row = 0; row < 3; row++)
            {
                for (int col = 0; col < 4; col++)
                {
                    <rect x="@(18 + col * 17)" y="@(40 + row * 12)" width="10" height="7" rx="1" class="@("a-win w" + ((row * 4 + col) % 5))" />
                }
            }
            <rect x="44" y="72" width="12" height="16" fill="#1c2129" />
            <line x1="80" y1="28" x2="80" y2="8" stroke="#8fa3b8" stroke-width="2" />
            <circle cx="80" cy="8" r="2.4" fill="@Color" />
            <circle cx="80" cy="8" r="3" class="a-ping" stroke="@Color" />
            <g class="a-orbit" style="transform-origin:50px 18px">
                <rect x="64" y="10" width="8" height="3" rx="1.5" fill="#e6edf3" />
                <circle cx="68" cy="14" r="1.6" fill="#3fd0ff" />
            </g>
            break;
    }
</svg>

@code {
    [Parameter] public string Id { get; set; }
    [Parameter] public string Color { get; set; }
}
