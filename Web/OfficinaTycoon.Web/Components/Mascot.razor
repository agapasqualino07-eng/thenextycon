@* "Bullo", the workshop robot: blinks, bobs and gives short tips in a speech bubble. Tap it for the next tip. *@
<div class="mascot @(Say != null ? "talking" : "")" data-test="mascot">
    @if (Say != null)
    {
        <div class="bubble" role="status">@Say</div>
    }
    <button class="mascot-btn" aria-label="Bullo, il robot dell'officina" @onclick="OnTap">
        <svg viewBox="0 0 80 90" aria-hidden="true">
            <line x1="40" y1="14" x2="40" y2="4" stroke="#1b1040" stroke-width="3" />
            <circle cx="40" cy="5" r="4.5" class="antenna" />
            <rect x="12" y="14" width="56" height="40" rx="16" fill="#ffc83d" stroke="#1b1040" stroke-width="3" />
            <rect x="19" y="22" width="42" height="24" rx="11" fill="#fff8e1" stroke="#1b1040" stroke-width="2.5" />
            <g class="eyes"><circle cx="31" cy="33" r="5" fill="#1b1040" /><circle cx="49" cy="33" r="5" fill="#1b1040" />
               <circle cx="32.6" cy="31.4" r="1.6" fill="#fff" /><circle cx="50.6" cy="31.4" r="1.6" fill="#fff" /></g>
            <path d="M33 41 Q40 46 47 41" stroke="#1b1040" stroke-width="2.5" fill="none" stroke-linecap="round" />
            <circle cx="22" cy="40" r="3" fill="#ff8fa3" opacity=".8" /><circle cx="58" cy="40" r="3" fill="#ff8fa3" opacity=".8" />
            <rect x="22" y="56" width="36" height="24" rx="9" fill="#3fa2ff" stroke="#1b1040" stroke-width="3" />
            <circle cx="40" cy="67" r="5" fill="#ffc83d" stroke="#1b1040" stroke-width="2" />
            <rect x="9" y="58" width="12" height="7" rx="3.5" fill="#3fa2ff" stroke="#1b1040" stroke-width="2.5" class="arm-l" />
            <rect x="59" y="58" width="12" height="7" rx="3.5" fill="#3fa2ff" stroke="#1b1040" stroke-width="2.5" class="arm-r" />
            <rect x="26" y="79" width="10" height="8" rx="3" fill="#5a43c2" stroke="#1b1040" stroke-width="2.5" />
            <rect x="44" y="79" width="10" height="8" rx="3" fill="#5a43c2" stroke="#1b1040" stroke-width="2.5" />
        </svg>
    </button>
</div>

@code {
    [Parameter] public string Say { get; set; }
    [Parameter] public EventCallback OnTap { get; set; }
}
