<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Installable web app (PWA) for iPhone/Android/desktop. It compiles the SAME game logic used by Unity and by the
    tests (Assets/Scripts/Core) to WebAssembly, plus the shared texts/formatting (Loc.cs, Fmt.cs).
    Dev tools (cheats, simulated ads, clock shift) exist only when built with -p:OfficinaDevTools=true.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OfficinaTycoon.Web</RootNamespace>
    <AssemblyName>OfficinaTycoon.Web</AssemblyName>
    <Version>0.4.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OfficinaDevTools)' == 'true'">
    <DefineConstants>$(DefineConstants);OFFICINA_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Scripts/Unity/Loc.cs" Link="Shared/Loc.cs" />
    <Compile Include="../../Assets/Scripts/Unity/Fmt.cs" Link="Shared/Fmt.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config/save types are mapped by reflection (JsonMapper): keep this assembly's metadata intact when trimming. -->
    <TrimmerRootAssembly Include="OfficinaTycoon.Web" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
